{
  "//": "Exemple iakaframe — variante hooks.json (au lieu du [hooks] inline dans config.toml). Cable les gardes IDENTITE + PERIMETRE + DELEGATION sur Codex CLI (experimental, non-Windows). Deposer les trois adaptateurs ET guard-core.mjs dans ~/.codex/hooks/. Meme verdict que Claude (coeur guard-core partage).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.codex/hooks/codex-identity-guard.mjs" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.codex/hooks/codex-identity-guard.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.codex/hooks/codex-perimeter-guard.mjs" },
          { "type": "command", "command": "node ~/.codex/hooks/codex-delegation-guard.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.codex/hooks/codex-delegation-guard.mjs" }
        ]
      }
    ]
  }
}
